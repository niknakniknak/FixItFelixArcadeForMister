diff --git a/modules/jtframe/hdl/sdram/jtframe_sdram64_dwnld.v b/modules/jtframe/hdl/sdram/jtframe_sdram64_dwnld.v
new file mode 100644
index 000000000..c32e3e5f1
--- /dev/null
+++ b/modules/jtframe/hdl/sdram/jtframe_sdram64_dwnld.v
@@ -0,0 +1,108 @@
+/* SPDX-FileCopyrightText: 2026 Chris Watson
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * Date: 14-11-2026 */
+
+// ROM download writer for jtframe_sdram64 (JTFRAME_DWNLD_BURST). It replaces the
+// programming bank: writes only, the row stays open while consecutive words fall in it.
+// Refresh takes the bus between words, but only after one word has been written since
+// the last refresh, so the download always moves. Times in clocks, for up to 100 MHz.
+module jtframe_sdram64_dwnld #(
+    parameter AW=22
+)(
+    input               rst,
+    input               clk,
+
+    input      [AW-1:0] addr,
+    input        [ 1:0] ba,
+    input               wr,
+    output              ack,
+    output              rdy,
+    output              dst,
+
+    output              br,
+    input               bg,
+    input               rfsh_br,
+    input               set_prech,
+    output              idle,
+    output              wr_busy,
+
+    output reg  [12:0]  sdram_a,
+    output reg  [ 3:0]  cmd
+);
+
+localparam ROW=13,
+           TRCD=2, TRP=2, TWR=2, TRAS=5, TRC=6;
+
+//                             /CS /RAS /CAS /WE
+localparam CMD_PRECHARGE   = 4'b0___0____1____0,
+           CMD_ACTIVE      = 4'b0___0____1____1,
+           CMD_WRITE       = 4'b0___1____0____0,
+           CMD_NOP         = 4'b0___1____1____1;
+
+wire [ROW-1:0] addr_row = AW==22 ? addr[AW-1:AW-ROW] : addr[AW-2:AW-1-ROW];
+reg  [ROW-1:0] row;
+reg  [    1:0] row_ba;
+reg            act, clean, acked, wrote;
+reg  [    2:0] t_wr, t_act, t_pre;
+wire           hit, block;
+reg            do_wr, do_pre, do_act;
+
+assign hit     = act && row==addr_row && row_ba==ba;
+assign br      = wr && !acked;
+assign block   = !bg || (rfsh_br && wrote);
+assign ack     = do_wr;
+assign rdy     = do_wr;
+assign dst     = do_wr;
+assign wr_busy = do_wr;
+assign idle    = (!br || wrote) && t_wr>=1 && t_act>=TRAS-1;
+
+always @(*) begin
+    do_wr  = !block && clean && hit && t_act>=TRCD;
+    do_pre = !block && (!clean || (act && !hit)) && t_wr>=TWR && t_act>=TRAS;
+    do_act = !block && clean && !act && t_pre>=TRP && t_act>=TRC;
+    cmd    = do_wr ? CMD_WRITE : do_pre ? CMD_PRECHARGE : do_act ? CMD_ACTIVE : CMD_NOP;
+    sdram_a[12:11] = addr_row[12:11];
+    sdram_a[10:0]  = do_act ? addr_row[10:0] : { do_pre, addr[AW-1], addr[8:0] };
+end
+
+always @(posedge clk) begin
+    if( rst ) begin
+        act   <= 0;
+        clean <= 0;
+        acked <= 0;
+        wrote <= 0;
+        row   <= 0;
+        row_ba<= 0;
+        t_wr  <= 3'd7;
+        t_act <= 3'd7;
+        t_pre <= 3'd7;
+    end else begin
+        acked <= do_wr;
+        if( t_wr !=3'd7 ) t_wr  <= t_wr +3'd1;
+        if( t_act!=3'd7 ) t_act <= t_act+3'd1;
+        if( t_pre!=3'd7 ) t_pre <= t_pre+3'd1;
+        if( do_wr ) begin
+            t_wr  <= 0;
+            wrote <= 1;
+        end
+        if( do_pre ) begin
+            act   <= 0;
+            clean <= 1;
+            t_pre <= 0;
+        end
+        if( do_act ) begin
+            act   <= 1;
+            row   <= addr_row;
+            row_ba<= ba;
+            t_act <= 0;
+        end
+        if( set_prech ) begin
+            act   <= 0;
+            clean <= 1;
+            wrote <= 0;
+            t_pre <= 0;
+        end
+    end
+end
+
+endmodule
