diff --git a/modules/jtframe/target/mister/hdl/jtframe_mister_fastio.v b/modules/jtframe/target/mister/hdl/jtframe_mister_fastio.v
new file mode 100644
index 000000000..068bcbf8e
--- /dev/null
+++ b/modules/jtframe/target/mister/hdl/jtframe_mister_fastio.v
@@ -0,0 +1,105 @@
+/*  This file is part of JTFRAME.
+    JTFRAME program is free software: you can redistribute it and/or modify
