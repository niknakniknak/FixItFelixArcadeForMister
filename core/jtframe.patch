+    along with JTFRAME.  If not, see <http://www.gnu.org/licenses/>.
+
+    Author: Chris Watson
+    Date: 14-11-2026 */
+
+// JTFRAME_MR_FASTIO=1 runs hps_io in WIDE mode: the HPS moves 16 bits per
+// transfer and ioctl_addr steps by 2. The rest of JTFRAME keeps its 8-bit
+// interface, so this module sits between the two:
+//  - download: the low byte goes out with the hps_io write (address A), the
+//    high byte GAP clocks later at A+1. The next word comes tens of clocks
+//    later (one SPI transfer, ~800 ns). Address and data stay at A+1 and the
+//    high byte until that next word, as hps_io holds them after a write:
+//    jtframe_ioctl_dump (NVRAM restore) takes the data a clock after the pulse.
+//  - upload (NVRAM save): the bytes at A and A+1 are read one after the other
+//    and offered to hps_io as one word, refreshed whenever A changes.
+// With WIDE=0 it is a plain connection.
+
+module jtframe_mister_fastio #(parameter
+    WIDE = 0,
+    GAP  = 4,   // clocks between the two byte writes of a word
+    RDLY = 6,   // clocks allowed for ioctl_din to follow the address on uploads
+    DW   = WIDE ? 15 : 7
+)(
+    input             clk,
+    // hps_io side
+    input             hpsw_upload,
+    input             hpsw_wr,
+    input      [26:0] hpsw_addr,
+    input      [DW:0] hpsw_dout,
+    output     [DW:0] hpsw_din,
+    // JTFRAME side, 8-bit
+    output            hps_wr,
+    output     [26:0] hps_addr,
+    output     [ 7:0] hps_dout,
+    input      [ 7:0] hps_din
+);
+
+generate
+    if( WIDE==0 ) begin : narrow
+        assign hps_wr   = hpsw_wr;
+        assign hps_addr = hpsw_addr;
+        assign hps_dout = hpsw_dout[7:0];
+        assign hpsw_din = hps_din;
+    end else begin : wide
+        reg        pend=0, hi_wr=0, hi_hold=0, rd_hi=0;
+        wire       hi_sel = !hpsw_wr && !hpsw_upload && (hi_wr || hi_hold);
+        reg [ 7:0] hi=0, rd_lo=0;
+        reg [15:0] din16=0;
+        reg [26:0] rd_addr=0;
+        reg [ 3:0] cnt=0, rcnt=0;
+
+        // second byte of a download word, or the odd byte of an upload word
+        assign hps_wr   = hpsw_wr | hi_wr;
+        assign hps_addr = (hi_sel | (hpsw_upload & rd_hi)) ? { hpsw_addr[26:1], 1'b1 } : hpsw_addr;
+        assign hps_dout = hi_sel ? hi : hpsw_dout[7:0];
+        assign hpsw_din = din16;
+
+        always @(posedge clk) begin
+            hi_wr <= 0;
+            if( hi_wr ) hi_hold <= 1;
+            if( hpsw_wr ) begin
+                hi_hold <= 0;
+                hi   <= hpsw_dout[15:8];
+                pend <= 1;
+                cnt  <= GAP[3:0];
+            end else if( pend ) begin
+                if( cnt!=0 ) cnt <= cnt - 4'd1;
+                else begin
+                    hi_wr <= 1;
+                    pend  <= 0;
+                end
+            end
+        end
+
+        always @(posedge clk) begin
+            if( !hpsw_upload || hpsw_addr!=rd_addr ) begin
+                rd_addr <= hpsw_addr;
+                rd_hi   <= 0;
+                rcnt    <= 0;
+            end else if( rcnt!=RDLY[3:0] ) begin
+                rcnt <= rcnt + 4'd1;
+            end else if( !rd_hi ) begin
+                rd_lo <= hps_din;
+                rd_hi <= 1;
+                rcnt  <= 0;
+            end else begin
+                din16 <= { hps_din, rd_lo };
+            end
+        end
+    end
+endgenerate
+
+endmodule
